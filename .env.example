# Required: obtain your own key from TMDB.
TMDB_API_KEY=

# Optional subtitles.
SUBDL_API_KEY=
OPENSUBTITLES_API_KEY=

# Optional on-demand Arabic subtitles from a self-hosted LibreTranslate service.
# Keep this off until the Oracle translator is reachable over HTTPS.
AUTO_TRANSLATE_ENABLED=false
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=

# Optional local Prisma subtitle database.
DATABASE_URL="file:./dev.db"

# Optional admin analytics. Set all values to enable /admin.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
